    "    combined_cloud_df[\"norm_area\"] = combined_cloud_df[\"avg_size[km]\"] * combined_cloud_df[\"Lifetime [h]\"]/T_tot\n",
    "    result_df.loc[dt, \"Mean tracked area non-filtered\"]= combined_cloud_df[\"norm_area\"].sum()\n",
    "    result_df.loc[dt, \"Cloud count non-filtered\"] = len(combined_cloud_df)\n",
    "    combined_cloud_df=combined_cloud_df[~combined_cloud_df.is_large_pix_cloud]\n",
    "    combined_cloud_df = combined_cloud_df[(combined_cloud_df.avg_lat >30) | (combined_cloud_df.avg_lat<-30)]\n",
    "    result_df.loc[dt, \"Mean tracked area\"]= combined_cloud_df[\"norm_area\"].sum()\n",
    "    result_df.loc[dt, \"Cloud count\"] = len(combined_cloud_df)\n"
   ]
