#!/bin/bash
#SBATCH -J cov_np_N
#SBATCH -t 05:00:00
#SBATCH -N 1
#SBATCH -n 16
#SBATCH --mem-per-cpu=5096
#SBATCH -q debug
#SBATCH --mail-type=END,FAIL
#SBATCH --output=/cluster/work/climate/dnikolo/Job_output/Output/%x.%j.out
#SBATCH --error=/cluster/work/climate/dnikolo/Job_output/Error/%x.%j.err
set -e

date
# Exit if the year variable is empty
# if [ -z "$1" ]; then
#    echo "Year variable is empty. Exiting..."
#    exit 1
# fi
#Change variable to counteract a common error in PyFLEXTRKR
export HDF5_USE_FILE_LOCKING=FALSE
module load stack/2024-06 gcc/12.2.0 openmpi/4.1.6 nco ffmpeg/6.0 hdf5 #python/3.11.6
# Force overwrite for every CDO call
cdo() { command cdo -O "$@"; }
year=2010

# Optional: define max number of parallel jobs
MAXJOBS=8

CLAAS_DIR=/nfs/ch4/wolke_scratch/dnikolo/CLAAS_Data/
# for month_dir in "${CLAAS_DIR}np/${year}"/*/
# do
month_dir="${CLAAS_DIR}np/${year}/11/"
for day_dir in "${month_dir}"/*/
do
    (
        if [[ $day_dir =~ ([0-9]{4})/([0-9]{2})//([0-9]{2})/ ]]; then
            filename="${BASH_REMATCH[1]}_${BASH_REMATCH[2]}_${BASH_REMATCH[3]}.nc"
        else
            echo "Didn't read name correctly"
            exit 1
        fi
        if [ -f "${CLAAS_DIR}/Cloud_cover_by_class/np/$filename" ]; then
            echo "File "${CLAAS_DIR}/Cloud_cover_by_class/np/$filename" already exists."
        else
            # --- Everything in this subshell runs in parallel for each day ---

            cd "$day_dir" || { echo "Failed to change directory to $day_dir"; exit 1; }
            echo "Processing: $day_dir"

            # 1) Merge CTX and CPP
            cdo -O -setmissval,0 -mergetime -apply,-selname,ctt,ctp [ "${day_dir}CTX*.nc" ] "combined_ctx.nc"
            cdo -O -setmissval,0 -mergetime -apply,-selname,cot [ "${day_dir}CPP*.nc" ] "combined_cpp.nc"

            # 2) Merge them and also merge with your AUX file
            cdo merge combined_ctx.nc combined_cpp.nc combined_total.nc
            cdo merge "${CLAAS_DIR}/np/CM_SAF_CLAAS3_L2_AUX.nc" combined_total.nc combined_aux.nc

            # 3) Filter by ctt/pixel_area if desired
            cdo expr,"ctp_filtered=(ctt>237.15)*(ctt<273.15)*(pixel_area<66)*ctp; \
                                    cot=cot; \
                                    pixel_area=pixel_area" \
                        combined_aux.nc classification_fields.nc

            # 4) Compute total and each cloud category area
            cdo expr,"\
                total = (ctp_filtered>0)*(cot>0)*pixel_area; \
                ci    = (ctp_filtered<440)*(ctp_filtered>0)*(cot>0)*(cot<3.6)*pixel_area; \
                cs    = (ctp_filtered<440)*(ctp_filtered>0)*(cot>3.6)*(cot<23)*pixel_area; \
                dc    = (ctp_filtered<440)*(ctp_filtered>0)*(cot>23)*(cot<379)*pixel_area; \
                ac    = (ctp_filtered>=440)*(ctp_filtered<680)*(cot>0)*(cot<3.6)*pixel_area; \
                as    = (ctp_filtered>=440)*(ctp_filtered<680)*(cot>3.6)*(cot<23)*pixel_area; \
                ns    = (ctp_filtered>=440)*(ctp_filtered<680)*(cot>23)*(cot<379)*pixel_area; \
                cu    = (ctp_filtered>=680)*(ctp_filtered<1000)*(cot>0)*(cot<3.6)*pixel_area; \
                sc    = (ctp_filtered>=680)*(ctp_filtered<1000)*(cot>3.6)*(cot<23)*pixel_area; \
                st    = (ctp_filtered>=680)*(ctp_filtered<1000)*(cot>23)*(cot<379)*pixel_area" \
                classification_fields.nc area_fields.nc

            # 5) Sum over the field to get area coverage
            cdo fldsum area_fields.nc class_cover_area.nc

            # 6) Compute fractions
            cdo expr,"\
                ci_frac=ci/total; \
                cs_frac=cs/total; \
                dc_frac=dc/total; \
                ac_frac=ac/total; \
                as_frac=as/total; \
                ns_frac=ns/total; \
                cu_frac=cu/total; \
                sc_frac=sc/total; \
                st_frac=st/total" \
                class_cover_area.nc class_cover.nc

            
            echo "Writing output: ${CLAAS_DIR}/Cloud_cover_by_class/np/$filename"
            cdo timmean class_cover.nc "${CLAAS_DIR}/Cloud_cover_by_class/np/$filename"
            

            # 8) Clean up
            rm -f class_cover.nc class_cover_area.nc area_fields.nc \
                    classification_fields.nc combined_aux.nc combined_total.nc \
                    combined_ctx.nc combined_cpp.nc

            echo "Finished: $day_dir"
        fi
    ) &  # <-- background this subshell so it runs in parallel

    # If you want to limit to $MAXJOBS concurrent tasks, do this:
    if (( $(jobs -r | wc -l) >= MAXJOBS )); then
        wait -n  # wait for at least one job to finish before launching another
    fi

done
echo "Done with ${month_dir}"
# After launching all days in parallel, wait for them to finish before next month
wait
# done
date