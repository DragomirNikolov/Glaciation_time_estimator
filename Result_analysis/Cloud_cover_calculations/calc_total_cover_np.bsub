#!/bin/bash
#SBATCH -J tot_cover_np
#SBATCH -t 20:00:00
#SBATCH -N 1
#SBATCH -n 24
#SBATCH --mem-per-cpu=4096
#SBATCH --tmp=50000
#SBATCH -q debug
#SBATCH --mail-type=END,FAIL
#SBATCH --output=/cluster/work/climate/dnikolo/Job_output/Output/%x.%j.out
#SBATCH --error=/cluster/work/climate/dnikolo/Job_output/Error/%x.%j.err
set -e

date

#Copy files to local scratch
# export TMPDIR="/cluster/work/climate/dnikolo/dump"
GTE_DIR=/cluster/work/climate/dnikolo/n2o/Glaciation_time_estimator
ENV_BIN_DIR=/cluster/work/climate/dnikolo/flex_trkr_2/bin



#Change variable to counteract a common error in PyFLEXTRKR
export HDF5_USE_FILE_LOCKING=FALSE
module load stack/2024-06 gcc/12.2.0 openmpi/4.1.6 nco ffmpeg/6.0 hdf5 #python/3.11.6
#Load pyflextrkr python
source "${ENV_BIN_DIR}"/activate
cd $GTE_DIR || exit
echo "GTE_CONFIG_DIR is ${GTE_CONFIG_DIR}"
python /cluster/work/climate/dnikolo/n2o/Glaciation_time_estimator/Result_analysis/Publication_figures/Multiyear_analysis/calc_total_cover_claas.py \
  --base /nfs/ch4/wolke_scratch/dnikolo/CLAAS_Data \
  --output /nfs/ch4/wolke_scratch/dnikolo/processed_daily_cph \
  --year 2010 \
  --workers 8 \
  --groups np \
  --verbose

if [ $? -ne 0 ]; then
    echo "Python script failed, exiting."
    exit 1
fi


date